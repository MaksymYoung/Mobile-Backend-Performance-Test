          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert w_api_prefix_search_e status OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-1381332885">${status_ok}</stringProp>
