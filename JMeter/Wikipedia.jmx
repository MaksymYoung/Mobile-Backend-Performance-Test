          </elementProp>
          <elementProp name="think_time_center" elementType="Argument">
            <stringProp name="Argument.name">think_time_center</stringProp>
            <stringProp name="Argument.value">${__jexl3((${__P(tt_min,2000)} + ${__P(tt_max,4000)}) / 2)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="think_time_spread" elementType="Argument">
            <stringProp name="Argument.name">think_time_spread</stringProp>
            <stringProp name="Argument.value">${__jexl3((${__P(tt_max,4000)} - ${__P(tt_min,2000)}) / 2)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="protocol" elementType="Argument">
